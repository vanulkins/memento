# Android build. The URL is public; the bootstrap secret must match the gateway.
MEMENTO_AI_BASE_URL=https://memento.example.com/api/mobile/v1
MEMENTO_APP_BOOTSTRAP_SECRET=replace-with-a-long-random-secret

# AI gateway.
PORT=8793
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=deepseek-v4-pro
APP_BOOTSTRAP_SECRET=replace-with-the-same-long-random-secret

